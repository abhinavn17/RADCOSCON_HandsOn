Bootstrap: docker
From: ubuntu:22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    # Update the package manager and install required dependencies
    apt-get update && apt-get install -y \
        software-properties-common \
        gfortran \
        git \
        htop \
        cmake \
        build-essential \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        libfreetype6-dev \
        libhdf5-dev \
        pkg-config \
        openmpi-bin \
        libopenmpi-dev \
        mpi-default-bin \
        vim \
        vim-gtk3 \
        mpich \
        xvfb \
        tar \
        wget \
        libcanberra-gtk-module \
        libcanberra-gtk3-module 
    
    apt-get clean
    
    add-apt-repository -s ppa:kernsuite/kern-9
    apt-add-repository multiverse
    apt-add-repository restricted
    apt-get update

    apt-get install -y \
        python3-casacore \
        aoflagger-dev \
        # wsclean-dev \
        # idg-dev \

    apt install -y \
        casacore-dev g++ \
        libblas-dev \
        libboost-date-time-dev libboost-filesystem-dev \
        libboost-program-options-dev libboost-system-dev \
        libcfitsio-dev libfftw3-dev libgsl-dev \
        liblapack-dev libopenmpi-dev \
        libpython3-dev


    cd /opt

    wget https://gitlab.com/aroffringa/wsclean/-/package_files/140629243/download

    tar -xvf download

    cd wsclean-v3.5

    mkdir -p build
    cd build
    cmake ../
    make
    make install

    # Clean up to reduce container size
    apt-get autoremove -y && apt-get clean

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%labels
    Author Abhinav Narayan
    Version 1.0
    Description Singularity container with wclean and other dependencies